{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u667a\u80fd\u6ef4\u5b9a\u8f6f\u4ef6","text":""},{"location":"#_2","title":"\u8f6f\u4ef6\u5b89\u88c5","text":"<p>\u53cc\u51fb<code>click_this.bat</code>\u7b49\u5f85\u5373\u53ef\u3002</p> <p>\u6253\u5f00vscode\u540e\uff0c\u70b9\u51fb<code>\u6269\u5c55</code>\uff0c\u5982\u679c\u6ca1\u6709\u4efb\u4f55\u63d2\u4ef6\u5219 </p> <p>\u4f9d\u6b21\u641c\u7d22\u5b89\u88c5\u4ee5\u4e0b\u63d2\u4ef6\uff0c\u641c\u7d22\u7ed3\u679c\u5e94\u8be5\u53ea\u6709\u4e00\u4e2a\u3002</p> <ol> <li>ms-python.python</li> <li>ms-python.vscode-pylance</li> <li>ms-toolsai.jupyter</li> <li>ms-toolsai.jupyter-renderers</li> </ol> <p></p> <p>\u6216\u8005\u5728\u5982\u56fe\u6587\u4ef6\u5939\u4e2d\u53f3\u952e\u5b89\u88c5\u6bcf\u4e00\u4e2a\u6587\u4ef6  </p>"},{"location":"#_3","title":"\u8f6f\u4ef6\u4f7f\u7528","text":"<p>\u8bf7\u5728\u5de6\u4fa7\u70b9\u51fb<code>\u64cd\u4f5c\u624b\u518c</code>\u540e\u81ea\u4e0a\u800c\u4e0b\u67e5\u770b\u3002\u5982\u679c\u9047\u5230\u5f02\u5e38\u60c5\u51b5\uff0c\u8bf7\u67e5\u8be2<code>\u5f02\u5e38\u5904\u7406</code>\u5206\u7ec4\u3002</p> <p>\u5982\u679c\u624b\u518c\u6ca1\u6709\u6807\u6ce8QRH\u94fe\u63a5\uff0c\u5728<code>\u5f02\u5e38\u5904\u7406</code>\u5206\u7ec4\u67e5<code>\u901a\u7528</code>.</p> <p>\u5982\u679c\u60a8\u770b\u5230\u7684\u662fPDF\uff0c\u76f4\u63a5\u5411\u4e0b\u6ed1\u52a8\u5373\u53ef\u3002</p>"},{"location":"notebooks/basic/","title":"\u57fa\u7840","text":""},{"location":"notebooks/basic/#_1","title":"\u57fa\u7840\u77e5\u8bc6","text":"<p>\u8fd9\u662fvscode jupyter\u754c\u9762\uff0c\u540e\u7eed\u6240\u6709\u5de5\u4f5c\u5c06\u5728\u6b64\u8fdb\u884c\u3002\u754c\u9762\u4e2d\u6570\u5b57\u6807\u53f7\u542b\u4e49\u53ca\u7528\u9014\u5982\u4e0b</p> <ol> <li>\u5982\u679c\u51fa\u73b0\u5361\u6b7b\u7b49\u5f02\u5e38\u60c5\u51b5\uff0c\u70b9\u91cd\u542f\u540e\u91cd\u65b0\u6267\u884c\u624b\u518c\u5185\u5bb9</li> <li>\u8fd9\u662f\u5355\u5143\u683c\u8bed\u8a00\uff0c\u5982\u679c\u5199\u7684\u662f<code>python</code>\u5c31\u662f\u53ef\u4ee5\u6267\u884c\u7684\u3002</li> <li>\u6267\u884c\u6309\u94ae</li> </ol> <p></p> <p>\u70b9\u51fb\u6267\u884c\u540e\uff0c\u5355\u5143\u683c\u5de6\u4e0b\u89d2\u4f1a\u51fa\u73b0\u5982\u56fe\u6807\u5fd7\uff0c\u5373\u6b63\u5728\u8fd0\u884c\u3002</p> <p></p> <p>\u6267\u884c\u540e\uff0c\u5355\u5143\u683c\u5de6\u4e0b\u89d2\u51fa\u73b0\u5982\u56fe\u56fe\u6807\uff0c\u4e0b\u65b9\u6709\u7ea2\u5b57\uff0c\u8bf4\u660e\u51fa\u9519\u3002</p>"},{"location":"notebooks/basic/#_2","title":"\u9009\u62e9\u5185\u6838","text":"<p>\u5982\u679c\u5728\u6267\u884c\u65f6\u9047\u5230\u4e86\u5982\u4e0b\u63d0\u793a</p> <p></p> <p>\u70b9\u51fb<code>python \u73af\u5883</code>\u540e\u9009\u62e9\u5e26\u6709\u661f\u7684\u9009\u9879</p> <p></p> <p>\u901a\u5e38\u8fd9\u540e\u9762\u662f.venv\u5f00\u5934\uff0c\u5982\u679c\u4e0d\u662f\uff0c\u91cd\u65b0\u5b89\u88c5\u73af\u5883\u3002</p>"},{"location":"notebooks/basic/#_3","title":"\u6253\u5f00\u6587\u4ef6\u5939","text":"<p>\u5982\u679c\u6253\u5f00vscode\u540e\u5de6\u8fb9\u6ca1\u6709\u6587\u4ef6\uff0c\u6309\u56fe\u4e2d\u987a\u5e8f\u64cd\u4f5c\u540e\u6253\u5f00\u6587\u4ef6\u5939</p> <p></p>"},{"location":"notebooks/ch340/","title":"Ch340","text":""},{"location":"notebooks/ch340/#ch340","title":"CH340 \u6b65\u8fdb\u7535\u673a\u63a7\u5236\u63a5\u53e3\u624b\u518c","text":"<p><code>CH340</code> \u63d0\u4f9b\u7edf\u4e00\u7684\u6ce8\u5c04\u6cf5\u63a7\u5236\u63a5\u53e3\uff0c\u652f\u6301\u540c\u6b65\u4e0e\u5f02\u6b65\u64cd\u4f5c\u3002</p>"},{"location":"notebooks/ch340/#_1","title":"\u521d\u59cb\u5316","text":"<pre><code>from your_module import CH340\n\npump = CH340(0)   # \u4f7f\u7528\u7b2c 0 \u4e2a\u4e32\u53e3\u8bbe\u5907\n# \u6216\npump = CH340(\"COM3\")\n</code></pre> <p>\u9ed8\u8ba4\u4f1a\u81ea\u52a8\u8fde\u63a5\u8bbe\u5907\uff0c\u5982\u9700\u624b\u52a8\u63a7\u5236\uff1a</p> <pre><code>pump = CH340(\"COM3\", auto_connect=False)\npump.connect()\n</code></pre>"},{"location":"notebooks/ch340/#_2","title":"\u8fde\u63a5\u4e0e\u65ad\u5f00","text":"<pre><code>pump.connect()\npump.disconnect()\n</code></pre>"},{"location":"notebooks/ch340/#_3","title":"\u72b6\u6001\u67e5\u8be2","text":"<pre><code>pump.connected   # \u662f\u5426\u5df2\u8fde\u63a5\npump.status      # \u7cfb\u7edf\u72b6\u6001\npump.volume      # \u5f53\u524d\u4f53\u79ef\npump.is_busy     # \u662f\u5426\u6b63\u5728\u8fd0\u884c\npump.running     # \u540c is_busy\uff08\u517c\u5bb9\u65e7\u4ee3\u7801\uff09\n</code></pre>"},{"location":"notebooks/ch340/#_4","title":"\u63a8\u6db2","text":"<p>\u6267\u884c\u4e0b\u65b9</p> <pre><code>pump.push(5, 500)\n</code></pre> <ul> <li><code>5</code>\uff1a\u4f53\u79ef\uff08mL\uff09</li> <li><code>500</code>\uff1a\u901f\u5ea6</li> </ul> <p>\u8bf4\u660e\uff1a\u540c\u6b65\u6267\u884c\uff0c\u4f1a\u7b49\u5f85\u8bbe\u5907\u5b8c\u6210\u52a8\u4f5c\u3002</p>"},{"location":"notebooks/ch340/#_5","title":"\u62bd\u6db2","text":"<p>\u6267\u884c\u4e0b\u65b9</p> <pre><code>pump.pull(25, 500)\n</code></pre> <ul> <li><code>25</code>\uff1a\u4f53\u79ef\uff08mL\uff09</li> <li><code>500</code>\uff1a\u901f\u5ea6</li> </ul> <p>\u8bf4\u660e\uff1a\u540c\u6b65\u6267\u884c\uff0c\u4f1a\u7b49\u5f85\u8bbe\u5907\u5b8c\u6210\u52a8\u4f5c\u3002</p>"},{"location":"notebooks/ch340/#_6","title":"\u56de\u96f6","text":"<p>\u6267\u884c\u4e0b\u65b9</p> <pre><code>pump.home()\n</code></pre> <p>\u8bf4\u660e\uff1a\u540c\u6b65\u6267\u884c\uff0c\u7b49\u5f85\u8bbe\u5907\u5b8c\u6210\u56de\u96f6\u3002</p>"},{"location":"notebooks/ch340/#_7","title":"\u5f02\u6b65\u63a8\u6db2","text":"<pre><code>pump.push_async(5, 500)\n</code></pre> <p>\u8bf4\u660e\uff1a\u7acb\u5373\u8fd4\u56de\uff0c\u4e0d\u7b49\u5f85\u6267\u884c\u5b8c\u6210\u3002</p>"},{"location":"notebooks/ch340/#_8","title":"\u5f02\u6b65\u62bd\u6db2","text":"<pre><code>pump.pull_async(3, 500)\n</code></pre> <p>\u8bf4\u660e\uff1a\u7acb\u5373\u8fd4\u56de\uff0c\u4e0d\u7b49\u5f85\u6267\u884c\u5b8c\u6210\u3002</p>"},{"location":"notebooks/ch340/#_9","title":"\u5f02\u6b65\u56de\u96f6","text":"<pre><code>pump.home_async()\n</code></pre> <p>\u8bf4\u660e\uff1a\u7acb\u5373\u8fd4\u56de\uff0c\u4e0d\u7b49\u5f85\u6267\u884c\u5b8c\u6210\u3002</p>"},{"location":"notebooks/ch340/#_10","title":"\u6ce8\u610f\u4e8b\u9879","text":"<ul> <li>\u540c\u6b65\u65b9\u6cd5\u5185\u90e8\u4f1a\u81ea\u52a8\u7b49\u5f85\u8bbe\u5907\u8fdb\u5165\u8fd0\u884c\u72b6\u6001\u5e76\u5b8c\u6210\u52a8\u4f5c\u3002</li> <li>\u82e5\u8bbe\u5907\u672a\u6b63\u786e\u54cd\u5e94\uff0c\u4f1a\u8f93\u51fa\u8b66\u544a\u4fe1\u606f\u3002</li> <li>\u901f\u5ea6\u53c2\u6570\u4f1a\u81ea\u52a8\u8f6c\u6362\u4e3a\u8bbe\u5907\u5185\u90e8\u901f\u5ea6\u5355\u4f4d\u3002</li> <li>\u5efa\u8bae\u5728\u64cd\u4f5c\u524d\u786e\u8ba4 <code>pump.connected == True</code>\u3002</li> </ul>"},{"location":"notebooks/part0/","title":"\u6536\u96c6\u6570\u636e","text":"Info <p>\u672c\u90e8\u5206\u5185\u5bb9\u9047\u5230\u5f02\u5e38\u65f6\u67e5\u8bbe\u5907\u8fde\u63a5/\u4e32\u53e3QRH</p>"},{"location":"notebooks/part0/#_1","title":"\u521d\u59cb\u5316\u7a0b\u5e8f","text":"<ol> <li>\u5728\u5de6\u4fa7\u6253\u5f00<code>notebooks</code>\u76ee\u5f55</li> <li>\u6253\u5f00part0_collect_images.ipynb`</li> <li>\u5728\u7b2c\u4e00\u4e2a\u5355\u5143\u683c\u5de6\u4fa7\uff0c\u70b9\u51fb\u7bad\u5934\u6240\u793a \u8fd0\u884c \u6309\u94ae</li> </ol> <ol> <li>\u4e0b\u5212\u5230\u7b2c\u4e8c\u4e2a\u4ee3\u7801\u5355\u5143\u683c\uff0c\u70b9\u51fb\u8fd0\u884c</li> <li>\u5728\u4e0b\u62c9\u6846\u4e2d\u9009\u62e9USB\u5f00\u5934\u7684\u8bbe\u5907</li> <li>\u9010\u4e2a\u6267\u884c\u63a5\u4e0b\u6765\u7684\u5355\u5143\u683c\u76f4\u5230\u51fa\u73b0\u754c\u9762</li> </ol> <p>\u5728\u6b64\u8fc7\u7a0b\u4e2d\uff0c\u6ce8\u5c04\u6cf5\u4f1a\u81ea\u52a8\u62bd\u6db2\u3002</p> <p></p>"},{"location":"notebooks/part0/#select_camera","title":"\u786e\u5b9a\u6444\u50cf\u5934","text":"<ol> <li>\u70b9\u51fb<code>\u542f\u52a8\u76f8\u673a</code> </li> </ol> <p>\u89c2\u5bdf\u5f39\u51fa\u7a97\u53e3\u662f\u5426\u4e3a\u6eb6\u6db2</p> <p>\u5982\u679c\u662f</p> <ul> <li>\u8df3\u8fc7\u4ee5\u4e0b\u6b65\u9aa4</li> </ul> <p>\u5982\u679c\u4e0d\u662f</p> <ol> <li>\u70b9\u51fb<code>\u5173\u95ed\u76f8\u673a</code></li> <li>\u5728\u5de6\u4fa7<code>\u6444\u50cf\u5934</code>\u4e0b\u62c9\u6846\u66f4\u6362\u5230\u4e0b\u4e00\u4e2a</li> <li>\u91cd\u590d\u6b65\u9aa41</li> </ol>"},{"location":"notebooks/part0/#_2","title":"\u6ef4\u6db2","text":"<ol> <li>\u4fee\u6539<code>\u6ef4\u5b9a\u901f\u7387</code>\uff0c\u5728100~1000\u4e4b\u95f4</li> <li>\u5c06<code>\u6ef4\u5b9a\u4f53\u79ef</code>\u6539\u4e3a\u9884\u671f\u503c\uff0c\u53ef\u4ee5\u5927\u4e8e25mL</li> <li>\u70b9\u51fb<code>\u5f00\u59cb\u6ef4\u6db2</code></li> </ol> <p>\u7a0b\u5e8f\u5c06\u81ea\u52a8\u5b8c\u6210\u6ef4\u6db2\uff0c\u5e76\u8bb0\u5f55\u6ef4\u6db2\u8fc7\u7a0b\u4e0d\u540c\u4f53\u79ef\u56fe\u7247</p> <ol> <li>\u70b9\u51fb<code>\u6253\u5f00\u76ee\u5f55</code>\u67e5\u770b\u7ed3\u679c</li> </ol> <p>\u5982\u679c\u60f3\u8981\u7ed3\u675f</p> <ul> <li>\u70b9\u51fb<code>\u5173\u95ed\u76f8\u673a</code></li> </ul> <p>\u5b8c\u6210\u4e00\u6b21\u6ef4\u6db2\u5e76\u66f4\u6362\u6eb6\u6db2\u540e</p> <ul> <li>\u70b9\u51fb<code>\u66f4\u6362\u76ee\u5f55</code></li> </ul>"},{"location":"notebooks/part0/#manual","title":"\u624b\u52a8\u64cd\u4f5c","text":"<p>\u5176\u4ed6\u64cd\u4f5c\u89c1CH340</p>"},{"location":"notebooks/part0/#_3","title":"\u62bd\u6db2","text":"<p>\u6267\u884c\u4e0b\u65b9 <pre><code>pump.pull(25, 500)\n</code></pre> \u5355\u5143\u683c\uff0c<code>25</code>\u662f\u4f53\u79ef\uff0c<code>500</code>\u662f\u901f\u5ea6</p>"},{"location":"notebooks/part0/#_4","title":"\u56de\u96f6","text":"<p>\u6267\u884c\u4e0b\u65b9 <pre><code>pump.home()\n</code></pre></p> <p>\u5982\u679c\u6ca1\u6709\u6392\u7a7a</p> <ul> <li>\u91cd\u8bd5</li> <li>\u79fb\u9664\u9488\u5934</li> </ul>"},{"location":"notebooks/part1/","title":"\u8bad\u7ec3\u6a21\u578b","text":"Info <p>\u672c\u90e8\u5206\u5185\u5bb9\u9047\u5230\u5f02\u5e38\u65f6\u67e5\u8bad\u7ec3\u8fc7\u7a0b\u548c\u7ed3\u679cQRH</p>"},{"location":"notebooks/part1/#_1","title":"\u521d\u59cb\u5316\u7a0b\u5e8f","text":"<ol> <li>\u5728\u5de6\u4fa7\u6253\u5f00<code>notebooks</code>\u76ee\u5f55</li> <li>\u6253\u5f00<code>part1_inference_training.ipynb</code></li> <li>\u5728\u7b2c\u4e00\u4e2a\u5355\u5143\u683c\u5de6\u4fa7\uff0c\u70b9\u51fb\u7bad\u5934\u6240\u793a \u8fd0\u884c \u6309\u94ae</li> </ol>"},{"location":"notebooks/part1/#_2","title":"\u8bbe\u7f6e\u8bad\u7ec3\u53c2\u6570","text":"<ol> <li>\u5c06<code>C:\\expiriment\\titration-new\\data_mo</code>\u66ff\u6362\u4e3a\u8bad\u7ec3\u6570\u636e\u76ee\u5f55</li> <li>\u5c06<code>model2</code>\u6539\u4e3a\u4f60\u9700\u8981\u7684\u540d\u5b57</li> <li>\u53c2\u8003\u4e0b\u8868\u8bbe\u7f6e\u8bad\u7ec3\u53c2\u6570\uff0c\u6216\u76f4\u63a5\u8fd0\u884c</li> </ol> \u53c2\u6570 \u542b\u4e49 \u53d6\u503c\u8303\u56f4 data_dir \u6570\u636e\u96c6\u76ee\u5f55 str model_name \u6a21\u578b\u540d\uff0c\u76f8\u540c\u540d\u79f0\u4f1a\u7ee7\u7eed\u8bad\u7ec3 str epochs \u8bad\u7ec3\u8f6e\u6570 \u975e\u8d1f\u6574\u6570 batch_size \u8bad\u7ec3\u7684\u4e00\u4e2a\u8d85\u53c2\u6570\uff0c\u8d8a\u5927\u8d8a\u5feb\uff0c\u4e5f\u8d8a\u4e0d\u7a33\u5b9a \u975e\u8d1f\u6574\u6570 learning_rate \u5b66\u4e60\u7387\uff0c\u8d8a\u5927\u8d8a\u5feb\uff0c\u4e5f\u8d8a\u4e0d\u7a33\u5b9a \u975e\u8d1f\u6574\u6570 val_split \u53d6\u591a\u5c11\u6bd4\u4f8b\u6837\u672c\u4f5c\u4e3a\u9a8c\u8bc1\u96c6 \\([0, 1]\\) <p>\u540e\u9762\u7684\u53c2\u6570\u770b\u4ee3\u7801\uff0c\u901a\u5e38\u4e0d\u9700\u8981\u6539\u3002</p>"},{"location":"notebooks/part1/#_3","title":"\u8bad\u7ec3","text":"<ol> <li>\u8fd0\u884c\u4e0b\u4e00\u4e2a\u5355\u5143\u683c\u5e76\u7b49\u5f85\u7ed3\u675f</li> </ol> \u9884\u671floss\u66f2\u7ebf <ol> <li>\u5728\u4f60\u8ba4\u4e3a\u53ef\u4ee5\u7ec8\u6b62\u65f6\u70b9\u51fb<code>\u4e2d\u65ad</code>\uff08\u5728\u754c\u9762\u4e0a\u65b9\uff09</li> </ol> \u5efa\u8bae <p>\u5728\u89c1\u5230loss\u663e\u8457\u964d\u4f4e\u540e\uff0c\u66f2\u7ebf\u62c9\u5e73\u540e10\u6b65\u5de6\u53f3\u5c31\u53ef\u4ee5\u505c\u4e0b\u4e86\u3002\u8bad\u7ec3\u8f6e\u6570\u8fc7\u591a\u5bb9\u6613\u5bfc\u81f4\u8fc7\u62df\u5408\u3002</p> <p>\u901a\u5e38\\(\\rm{loss}&lt;1\\)</p> <p>\u901a\u5e38loss\u4e0d\u5e94\u8be5\u505c\u5728\\(0.6\\sim 0.7\\)</p> <ol> <li>\u5982\u679c\u4f60\u8ba4\u4e3a\u8fd8\u4e0d\u53ef\u4ee5\u7ec8\u6b62\uff0c\u4f46\u8bad\u7ec3\u7ed3\u675f\u4e86\uff0c\u4fee\u6539<code>epochs</code>\u53c2\u6570</li> </ol>"},{"location":"notebooks/part2/","title":"\u81ea\u52a8\u6ef4\u5b9a","text":"Info <p>\u672c\u90e8\u5206\u5185\u5bb9\u9047\u5230\u5f02\u5e38\u65f6\u67e5\u8bad\u7ec3\u8fc7\u7a0b\u548c\u7ed3\u679cQRH\u548c\u63a8\u7406\u8fc7\u7a0bQRH</p>"},{"location":"notebooks/part2/#_1","title":"\u521d\u59cb\u5316\u7a0b\u5e8f","text":"<ol> <li>\u5728\u5de6\u4fa7\u6253\u5f00<code>notebooks</code>\u76ee\u5f55</li> <li>\u6253\u5f00<code>part2_export_titration.ipynb</code></li> <li>\u5728\u7b2c\u4e00\u4e2a\u5355\u5143\u683c\u5de6\u4fa7\uff0c\u70b9\u51fb\u7bad\u5934\u6240\u793a \u8fd0\u884c \u6309\u94ae</li> </ol>"},{"location":"notebooks/part2/#_2","title":"\u9009\u62e9\u6a21\u578b","text":"<ol> <li>\u8fd0\u884c\u4e0b\u4e00\u4e2a\u5355\u5143\u683c</li> <li>\u9009\u62e9\u8bad\u7ec3\u7684\u6a21\u578b\u540d</li> </ol>"},{"location":"notebooks/part2/#_3","title":"\u8bbe\u7f6e\u53c2\u6570","text":"<p>\u627e\u5230 <pre><code># 1. Define Titration Configuration\ntitration_config = InferenceConfig(\n    speed=15.0,\n    vol_=1,\n    slide_time=30.0,\n    record=True,\n    delay_time=5.0,\n    end_percent=60.0,\n    loop_delay=0.1,\n    init_ml=0.0,\n    camera_id=1,\n    camera_prefix=\"Input/notebook_test\",\n    end_label=\"transport\",\n)\n</code></pre></p> <p>\u53c2\u6570\u542b\u4e49\u5982\u4e0b</p> \u53c2\u6570 \u542b\u4e49 \u53d6\u503c\u8303\u56f4 <code>speed</code> \u6ce8\u5c04\u6cf5\u63a8\u8fdb\u7684\u901f\u5ea6\uff0c\u5355\u4f4d mL/min\uff0c\u8d8a\u5927\u6ef4\u5b9a\u8d8a\u5feb \u975e\u8d1f\u6574\u6570 <code>vol_</code> \u6bcf\u6b21\u6ef4\u52a0\u7684\u4f53\u79ef\uff08\u5355\u6b21\u63a8\u8fdb\u91cf\uff09 \\([1,\\,\\infty]\\) <code>slide_time</code> \u6ed1\u52a8\u65f6\u95f4\u7a97\u53e3\uff0cAI \u4f1a\u7efc\u5408\u8fc7\u53bb\u8fd9\u6bb5\u65f6\u95f4\u5185\u7684\u753b\u9762\u5224\u65ad\uff0c\u907f\u514d\u77ac\u65f6\u8bef\u5224 \u975e\u8d1f\u6574\u6570 <code>record</code> \u662f\u5426\u4fdd\u5b58\u6ef4\u5b9a\u8fc7\u7a0b\u56fe\u50cf True / False <code>delay_time</code> \u5224\u5b9a\u7ec8\u70b9\u540e\u9700\u8981\u6301\u7eed\u7a33\u5b9a\u89c2\u5bdf\u7684\u65f6\u95f4\uff0c\u786e\u4fdd\u989c\u8272\u4e0d\u56de\u9000 \u975e\u8d1f\u6574\u6570 <code>end_percent</code> \u5728\u6ed1\u7a97\u65f6\u95f4\u5185\uff0c\u88ab\u5224\u5b9a\u4e3a\u7ec8\u70b9\u72b6\u6001\u7684\u753b\u9762\u6bd4\u4f8b\u9608\u503c \\([0,\\,1]\\) <code>loop_delay</code> \u6bcf\u6b21\u6ef4\u6db2\u540e\u7b49\u5f85\u591a\u4e45\u518d\u8fdb\u884c\u68c0\u6d4b\uff0c\u7ed9\u53cd\u5e94\u65f6\u95f4 \u81ea\u7136\u6570 <code>init_ml</code> \u521d\u59cb\u7d2f\u8ba1\u4f53\u79ef\uff0c\u5bf9\u5e94\u6ce8\u5c04\u5668\u8d77\u59cb\u8bfb\u6570 \u81ea\u7136\u6570 <code>camera_id</code> \u6444\u50cf\u5934\u8bbe\u5907ID\uff0c\u5982\u65e0\u6cd5\u786e\u8ba4\u53c2\u8003\u786e\u5b9a\u6444\u50cf\u5934 \u975e\u8d1f\u6574\u6570 <code>camera_prefix</code> \u76f8\u673a\u6807\u8bc6\u524d\u7f00\uff0c\u7528\u4e8e\u533a\u5206\u8bbe\u5907\u6216\u6587\u4ef6\u547d\u540d str <code>end_label</code> \u7ec8\u70b9\u7c7b\u522b\u6807\u7b7e\uff08AI\u8bc6\u522b\u76ee\u6807\uff09\uff0c\u5e94\u4e25\u683c\u7b26\u5408\u8bad\u7ec3\u65f6\u8bbe\u7f6e\u7684 \u679a\u4e3e\u578b <p>\u8bbe\u7f6e\u5b8c\u6210\u6267\u884c\u5355\u5143\u683c\u5373\u53ef</p>"},{"location":"notebooks/part2/#_4","title":"\u624b\u52a8\u64cd\u4f5c","text":"<ol> <li>\u6267\u884c\u4e0b\u5355\u5143\u683c\u521d\u59cb\u5316 <pre><code>pump = CH340(device)\n</code></pre></li> <li>\u53c2\u8003\u624b\u52a8\u64cd\u4f5c</li> <li>\u5fc5\u987b\u6267\u884c\u4e0b\u5217\u4ee3\u7801\u624d\u80fd\u518d\u6b21\u81ea\u52a8\u6ef4\u5b9a <pre><code>pump.disconnect()\n</code></pre></li> </ol>"},{"location":"qrh/common/","title":"\u901a\u7528","text":""},{"location":"qrh/common/#_1","title":"\u7a0b\u5e8f\u5361\u6b7b","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u4efb\u4f55\u6761\u4ef6</p> <ul> <li>\u70b9\u51fb\u8fd0\u884c\u540e\uff0c\u672a\u51fa\u73b0<code>\u6b63\u5728\u8fd0\u884c</code>\u6807\u5fd7\u6216\u51fa\u73b0\u5176\u4ed6\u56fe\u6807</li> <li>\u62a5\u9519\u663e\u793a<code>\u62d2\u7edd\u8bbf\u95ee</code></li> <li>\u62a5\u544a\u672a\u77e5\u9519\u8bef\uff0c\u4e14\u672a\u4fee\u6539\u4ee3\u7801\uff0c\u4e14\u9519\u8bef\u4e2d\u4e0d\u5305\u542b<code>ImportError</code></li> <li>\u6765\u81ea\u5176\u4ed6QRH\u7684\u60c5\u51b5</li> </ul> jupyter\u91cd\u542f\u6309\u94ae\u70b9\u51fb \u53f3\u4e0b\u89d2\u5f39\u7a97\u6d88\u5931 \u5982\u679c\u957f\u65f6\u95f4\u4e0d\u6d88\u5931\u6216\u6545\u969c\u672a\u7f13\u89e3 vscode\u7a97\u53e3\u91cd\u542f \u5982\u679c\u6545\u969c\u672a\u80fd\u7f13\u89e3 \u62a5\u544a\u672a\u9884\u671f\u7684\u6545\u969c\u6216\u8be2\u95eeAI."},{"location":"qrh/common/#jupyter","title":"jupyter\u5361\u6b7b","text":"\u6761\u4ef6 <ul> <li>\u70b9\u51fb\u91cd\u542f\u540e\uff0c\u53f3\u4e0b\u89d2\u56fe\u6807\u957f\u671f\u672a\u6d88\u5931</li> </ul> <p>\u91cd\u542fvscode</p>"},{"location":"qrh/common/#_2","title":"\u73af\u5883\u914d\u7f6e\u5f02\u5e38","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u4efb\u4f55\u6761\u4ef6</p> <ul> <li>\u70b9\u51fbclick_me.bat\u540e\uff0c\u63a7\u5236\u53f0\u7a97\u53e3\u4e8e15s\u5185\u5173\u95ed</li> <li>\u5b89\u88c5\u8fc7\u7a0b\u63a7\u5236\u53f0\u6ca1\u6709\u51fa\u73b0\u4e00\u6392\u7eff\u8272<code>[+]</code></li> <li>\u8fd0\u884c\u4ee3\u7801\u51fa\u73b0<code>ImportError</code></li> <li>\u9009\u62e9\u5185\u6838\u65f6\u6ca1\u6709\u5e26\u661f\u7684</li> <li>\u9009\u62e9\u5185\u6838\u65f6\u5e26\u661f\u7684\u9009\u9879\u4e0d\u4ee5.venv\u5f00\u5934</li> <li>\u9009\u62e9\u5185\u6838\u65f6\u62a5\u9519</li> <li>\u7f3a\u5931.venv\u6587\u4ef6\u5939</li> </ul> .venv\u6587\u4ef6\u5939\u5220\u9664 \u7f51\u7edc\u8fde\u63a5 click_me.bat\u91cd\u65b0\u8fd0\u884c \u5b89\u88c5vscode\u7684\u5f39\u7a97\u62d2\u7edd\u7ba1\u7406\u5458\u6743\u9650 vscode\u91cd\u542f \u5982\u679c\u95ee\u9898\u672a\u80fd\u7f13\u89e3 \u7f51\u7edc\u66f4\u6362 \u5f53\u524d\u68c0\u67e5\u5355\u91cd\u65b0\u6267\u884c \u5982\u679c\u95ee\u9898\u672a\u80fd\u7f13\u89e3 \u62a5\u544a\u672a\u9884\u671f\u9519\u8bef\u6216\u8be2\u95eeAI."},{"location":"qrh/infer/","title":"\u63a8\u7406\u8fc7\u7a0b","text":""},{"location":"qrh/infer/#_1","title":"\u8fd0\u884c\u4e0e\u8bad\u7ec3\u95ee\u9898\u6392\u67e5","text":""},{"location":"qrh/infer/#_2","title":"\u672a\u80fd\u5f00\u59cb","text":"\u6761\u4ef6 <p>\u8fd0\u884c\u7a0b\u5e8f\u540e\uff0c\u6eb6\u6db2\u5b8c\u5168\u6ca1\u6709\u53d8\u8272\uff0c\u7a0b\u5e8f\u5c31\u505c\u6b62\u4e86\u3002</p> <p></p>"},{"location":"qrh/infer/#_3","title":"\u8bef\u5224\u4e25\u91cd","text":"\u6761\u4ef6 <p>\u6ef4\u6db2\u521a\u8fdb\u5165\u6c34\u4e2d\u3001\u77ac\u95f4\u53d8\u8272\u540e\uff0c\u7a0b\u5e8f\u5c31\u505c\u6b62\u4e86\u3002</p> <p>\u8fd9\u79cd\u60c5\u51b5\u901a\u5e38\u662f\u56e0\u4e3a\u7a0b\u5e8f\u628a\u77ed\u6682\u7684\u989c\u8272\u53d8\u5316\u8bef\u5224\u4e3a\u7a33\u5b9a\u7ec8\u70b9\u3002</p> \u6ed1\u7a97\u65f6\u957f\u52a0\u5927 \u7a33\u5b9a\u5224\u5b9a\u65f6\u957f\u52a0\u5927 \u7ec8\u70b9\u5224\u5b9a\u6bd4\u4f8b\u63d0\u9ad8"},{"location":"qrh/infer/#_4","title":"\u4e25\u91cd\u8fc7\u91cf","text":"\u6761\u4ef6 <p>\u6eb6\u6db2\u5df2\u7ecf\u663e\u8457\u8fc7\u91cf\uff0c\u4f46\u7a0b\u5e8f\u6ca1\u80fd\u53ca\u65f6\u505c\u4e0b\u3002</p> <p></p>"},{"location":"qrh/serial/","title":"\u8bbe\u5907\u8fde\u63a5/\u4e32\u53e3","text":""},{"location":"qrh/serial/#xxx","title":"\u627e\u4e0d\u5230<code>xxx</code>\u4e32\u53e3","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u6240\u6709\u6761\u4ef6\u5219\u6267\u884c</p> <ul> <li>\u73af\u5883\u5df2\u7ecf\u5b89\u88c5</li> <li>\u6ca1\u6709\u7ea2\u5b57\u9519\u8bef</li> <li>\u8bbe\u5907USB\u5df2\u8fde\u63a5</li> <li>\u8bbe\u5907\u5f00\u5173\u5df2\u5f00\u542f</li> </ul> <ol> <li>\u6253\u5f00\u624b\u673a\u84dd\u7259</li> <li>\u641c\u7d22\u8bbe\u5907\uff0c\u5bfb\u627e\u8bbe\u5907\u7f16\u53f7</li> </ol> <p>\u5982\u679c\u627e\u4e0d\u5230</p> <ul> <li>\u6267\u884c\u91cd\u542f\u8bbe\u5907</li> </ul> <p>\u5982\u679c\u80fd\u627e\u5230\u6216\u4e0d\u4f1a\u64cd\u4f5c</p> <ol> <li>\u6309\u4e0b<code>win+R</code></li> <li>\u8f93\u5165<code>devmgmt.msc</code></li> <li>\u627e\u5230<code>\u7aef\u53e3(COM\u548cLPT)</code></li> </ol> <p>\u5982\u679c\u627e\u4e0d\u5230</p> <ul> <li>\u6267\u884c\u91cd\u542f\u8bbe\u5907</li> </ul> <p>\u5982\u679c\u627e\u5230</p> <ol> <li> <p>\u53cc\u51fb\u6253\u5f00\u5217\u8868 </p> <p>\u5982\u679c\u786e\u5b9e\u6ca1\u6709<code>xxx</code>\u8bbe\u5907</p> <ul> <li>\u6267\u884c\u91cd\u542f\u8bbe\u5907</li> </ul> <p>\u5982\u679c\u8bbe\u5907\u53cd\u590d\u51fa\u73b0-\u6d88\u5931</p> <ul> <li> <p>\u6267\u884c\u91cd\u542f\u8bbe\u5907</p> <p>\u5982\u679c\u6ca1\u80fd\u7f13\u89e3 \u4e14 \u84dd\u7259\u641c\u4e0d\u5230\u8bbe\u5907</p> </li> <li> <p>\u5c06\u8bbe\u5907\u62a5\u544a\u4e3a<code>\u8bbe\u5907\u5185\u7a0b\u5e8f\u6545\u969c\uff0c\u53d1\u751f\u65e0\u9650\u91cd\u542f</code>\uff0c\u8054\u7cfb\u5382\u5546.</p> </li> </ul> <p>\u5982\u679c\u6709<code>xxx</code>\u8bbe\u5907</p> <ul> <li>\u91cd\u65b0\u8fd0\u884c\u5305\u542b\u4ee5\u4e0b\u4ee3\u7801\u7684\u5355\u5143\u683c <pre><code>port = widgets.Dropdown(\n    description=\"\u9009\u62e9\u8bbe\u5907\",\n    options=list_ch340_ports(),\n)\nport\n</code></pre></li> </ul> </li> </ol>"},{"location":"qrh/serial/#_1","title":"\u6267\u884c\u547d\u4ee4\u540e\u957f\u65f6\u95f4\u672a\u54cd\u5e94","text":"\u624b\u52a8\u64cd\u4f5c\u56de\u96f6\u6267\u884c \u5982\u4f9d\u65e7\u65e0\u54cd\u5e94 USB\u6570\u636e\u7ebf\u65ad\u5f00 USB\u6570\u636e\u7ebf\u8fde\u63a5 \u5982\u672a\u80fd\u7f13\u89e3 <ul> <li>\u6267\u884c\u91cd\u542f\u8bbe\u5907</li> </ul>"},{"location":"qrh/serial/#restart","title":"\u91cd\u542f\u8bbe\u5907","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u4efb\u4f55\u6761\u4ef6</p> <ul> <li>\u53d1\u9001\u4efb\u4f55\u547d\u4ee4\u540e\uff0c\u8bbe\u5907\u65e0\u54cd\u5e94</li> <li>\u84dd\u7259\u641c\u4e0d\u5230\u8bbe\u5907</li> <li>\u6765\u81ea\u5176\u4ed6QRH\u7684\u60c5\u51b5</li> </ul> \u8bbe\u5907\u5f00\u5173\u5173\u95ed USB\u6570\u636e\u7ebf\u65ad\u5f00 \u9759\u6b62\u7b49\u5f8515S \u8bbe\u5907\u5f00\u5173\u6253\u5f00 USB\u6570\u636e\u7ebf\u8fde\u63a5 \u5982\u679c\u6545\u969c\u4f9d\u65e7 \u66f4\u6362\u8bbe\u5907\u6216\u62a5\u544a."},{"location":"qrh/train/","title":"\u8bad\u7ec3\u8fc7\u7a0b","text":""},{"location":"qrh/train/#loss0607","title":"loss\u503c\u957f\u671f\u5361\u57280.6~0.7","text":"<p>loss\u503c\u957f\u671f\u5361\u57280.6~0.7\u4ee3\u8868\u7740\u6a21\u578b\u5b8c\u5168\u6ca1\u80fd\u5b66\u4e60\u5230\u4efb\u4f55\u4fe1\u606f</p> <ul> <li>\u68c0\u67e5\u56fe\u7247\u5206\u7c7b\u662f\u5426\u6709\u8bef\u3002</li> </ul> <p>\u5982\u65e0\u8bef</p> <ul> <li>\u6267\u884c\u8bad\u7ec3\u4e0d\u7a33\u5b9a</li> </ul>"},{"location":"qrh/train/#_1","title":"\u662f\u4e0d\u662f\u8bad\u7ec3\u8d8a\u4e45\u8d8a\u597d","text":"<p>\u4e0d\u662f\uff0c\u5728loss\u663e\u8457\u964d\u4f4e\u540e\u518d\u8bad\u7ec310\u8f6e\u5de6\u53f3\u5c31\u53ef\u4ee5\u505c\u6b62\u4e86\u3002</p>"},{"location":"qrh/train/#_2","title":"\u8fc7\u62df\u5408","text":"\u6761\u4ef6 <p>\u8bad\u7ec3\u7684\u65f6\u633a\u597d\uff0c\u5b9e\u9645\u5b8c\u5168\u79bb\u8c31</p> <p>\u8fd9\u79cd\u60c5\u51b5\u88ab\u79f0\u4e3a\u3010\u8fc7\u62df\u5408\u3011\u3002\u53ef\u80fd\u7531\u4e8e\u4ee5\u4e0b\u539f\u56e0</p> epochs\u51cf\u5c0f \u8bad\u7ec3\u6570\u636e\u8865\u5145 \u8bad\u7ec3\u6570\u636e\u4e0d\u540c\u7c7b\u522b\u56fe\u7247\u6570\u91cf\u76f8\u8fd1 seed\u66f4\u6362"},{"location":"qrh/train/#loss","title":"loss\u503c\u51e0\u4e4e\u4e0d\u964d\u4f4e","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u6240\u6709\u6761\u4ef6</p> <ul> <li>1\u5206\u949f\u5185\u6709\u65b0\u7684\u70b9\u51fa\u73b0</li> <li>\u5df2\u5b8c\u6210\u7684\u8bad\u7ec3\u8f6e\u6570\u8d85\u8fc7100</li> <li>loss\u503c\u672a\u89c1\u663e\u8457\u5347\u9ad8\uff08\u8d85\u8fc71\uff09</li> <li>loss\u503c\u672a\u89c1\u663e\u8457\u6ce2\u52a8</li> </ul> learning_rate\u63d0\u9ad8"},{"location":"qrh/train/#_3","title":"\u8bad\u7ec3\u8fc7\u6162","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u6240\u6709\u6761\u4ef6</p> <ul> <li>5\u5206\u949f\u5185\u56fe\u793a\u6ca1\u6709\u6570\u636e\u70b9</li> <li>\u4e0b\u65b9\u65e5\u5fd7\u6ca1\u6709     <pre><code>[Epoch xxx] Train Loss: xxx, Val Loss: xxx, Val Acc: xxx\n</code></pre></li> <li>\u65e5\u5fd7\u51fa\u73b0\u4e86 <pre><code>[Message] \u5f00\u59cb\u8bad\u7ec3\u6a21\u578b for xxx epochs on device xxx.\n</code></pre></li> </ul> learning_rate\u63d0\u9ad8 batch_size\u63d0\u9ad8"},{"location":"qrh/train/#unsable","title":"\u8bad\u7ec3\u4e0d\u7a33\u5b9a","text":"\u6761\u4ef6 <p>\u5982\u679c\u6ee1\u8db3\u4ee5\u4e0b\u4efb\u4f55\u6761\u4ef6</p> <ul> <li>loss\u503c\u53cd\u590d\u4e25\u91cd\u6ce2\u52a8</li> <li>loss&gt;1</li> </ul> \u5982loss\u5df2\u7ecf\u663e\u8457\u964d\u4f4e \u8bad\u7ec3\u7ec8\u6b62 \u5982\u672a\u89c1\u663e\u8457\u964d\u4f4e learning_rate\u51cf\u5c0f batch_size\u51cf\u5c0f \u8bad\u7ec3\u6570\u636e\u8865\u5145"}]}